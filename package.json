{
  "name": "hearthspace-ui-experiments",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.ts",
    "test:browser": "vitest run",
    "test:browser:watch": "vitest --browser.headless=false",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "6.41.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
